#!/bin/sh

# Run Laravel Pint on staged PHP files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "\.php$")

if [ -n "$STAGED_FILES" ]; then
    echo "Running Laravel Pint on staged files..."

    # Run Pint on staged files
    ./vendor/bin/pint --test $STAGED_FILES
    PINT_EXIT_CODE=$?

    if [ $PINT_EXIT_CODE -ne 0 ]; then
        echo ""
        echo "Code style issues found. Run 'composer lint:fix' to fix them."
        echo "Or run './vendor/bin/pint' to auto-fix all files."
        exit 1
    fi

    echo "Code style check passed!"
fi

exit 0
